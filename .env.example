# --- Agent (optional) -------------------------------------------------------
# Without this the agent still works: the client silently falls back to the
# local keyword engine in src/agent/local.js. With it, /api/agent proxies to
# Gemini and the agent can answer freely and drive the UI through tools.
#
# Get a key from https://aistudio.google.com/apikey. Set it in the hosting
# provider's environment variables, never in a committed file.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.8-flash

# Spend guards. Both are counted per serverless instance, so treat them as a
# ceiling on the common case rather than a hard global limit. Past either one
# the endpoint returns 429 and the browser falls back to the offline engine.
AGENT_DAILY_PER_IP=40
AGENT_DAILY_TOTAL=1000

# --- Contact form (optional) ------------------------------------------------
# Without this /api/contact returns 501 and the Contact window falls back to
# opening the visitor's mail client with the message pre-filled.
RESEND_API_KEY=re_...
CONTACT_TO=ayasser.hashem@gmail.com
CONTACT_FROM=portfolio@ahmedyasser.dev
